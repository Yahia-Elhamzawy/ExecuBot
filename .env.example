# ==============================================================
# ExecuBot - Desktop WhatsApp AI Executive Assistant Configuration
# You can also configure all keys & models directly from the app UI!
# ==============================================================

# Server Port
PORT=3001

# Google Gemini API Key (Required for 1-on-1 contact chat & audio STT)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# NVIDIA NIM API Key (Required for group daily summaries & deep reasoning)
# Get your free 1,000 credits at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Voice Notes (PTT) Configuration
DEFAULT_VOICE=ar-EG-ShakirNeural

# Emergency Escalation Phone Number (Optional - your personal number with country code, e.g., 201234567890)
PRIVATE_PHONE_NUMBER=
